# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── Secretos y credenciales ────────────────────────────────────────
.env.agent
.env
.env.*
!.env.example

# ── Configuración personal (generada por install.sh) ───────────────
.config/user.conf

# ── Runtime del agente ─────────────────────────────────────────────
agent/cache/project-index.json
agent/cache/project-snapshot.json
agent/memory/sessions/*.md
.nas-agent/

# ── Logs (solo archivos .log dinámicos, NO listas de paquetes) ─────
*.log

# ── Backups del instalador ─────────────────────────────────────────
*.bak.*

# ── IDE / Herramientas locales ─────────────────────────────────────
.kiro/

# Configuración Kiro compartida del proyecto (persistente)
!.kiro/
.kiro/*
!.kiro/hooks/
.kiro/hooks/*
!.kiro/hooks/documentation-evolution-on-prompt.json
!.kiro/skills/
.kiro/skills/*
!.kiro/skills/documentation-evolution/
!.kiro/skills/documentation-evolution/SKILL.md
!.kiro/skills/datasql/
!.kiro/skills/datasql/SKILL.md
!.kiro/skills/nas-runtime-secrets/
