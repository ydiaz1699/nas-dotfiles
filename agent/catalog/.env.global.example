# /docker/.env — Variables compartidas por todos los servicios
# Cambiar aquí = cambia en todos los servicios al reiniciar
#
# Uso en compose.yml de cada servicio:
#   env_file:
#     - ../.env      ← este archivo (global)
#     - .env         ← secretos locales del servicio
#
# El .env local del servicio sobreescribe al global si hay conflicto.
# Ejemplo: si EMQX necesita otro TZ, lo pone en $dkco/emqx/.env y gana.
#
# Instalar en tu NAS:
#   cp $NAS_DOTFILES/agent/catalog/.env.global.example $dkco/.env
#   nano $dkco/.env   # ajustar SERVER_IP a tu IP real
#   chmod 600 $dkco/.env

SERVER_IP=__pega_aqui__
TZ=America/La_Paz
