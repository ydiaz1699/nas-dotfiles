# Plantillas de variables para Kiro CLI (y sus MCPs asociados)
# En el NAS se guardan en archivos separados con chmod 600 dentro de /docker/kiro-cli/

# ── nextdns.env (chmod 600) ──
# NEXTDNS_APIKEY_INFINIX=tu_api_key_aqui
# NEXTDNS_PROFILE_INFINIX=2511f5
# NEXTDNS_APIKEY_PAPA=tu_api_key_aqui
# NEXTDNS_PROFILE_PAPA=2f6df5

# ── n8n.env (chmod 600) ──
# N8N_API_URL=http://192.168.1.200:5678
# N8N_API_KEY=tu_api_key_rest_n8n

# ── jdownloader.env (chmod 600) ──
# JD_EMAIL=tu_correo@gmail.com
# JD_PASSWORD=tu_password_myjdownloader
# JD_DEVICE_NAME=JDownloader@Alex
# JD_LOG_LEVEL=ERROR
# NOPECHA_API_KEY=

# ── karakeep.env (chmod 600) ──
# KARAKEEP_API_ADDR=http://192.168.1.200:3400
# KARAKEEP_API_KEY=tu_api_key_karakeep

# ── rclone-rcd/.env (chmod 600, en /docker/rclone-rcd/) ──
# RCLONE_RC_USER=nasadmin
# RCLONE_RC_PASS=password_generada_aleatoria
