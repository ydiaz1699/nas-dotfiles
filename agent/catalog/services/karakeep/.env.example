# Karakeep — .env LOCAL (solo secretos y config de IA).
# SERVER_IP y TZ se heredan del .env GLOBAL ($dkco/.env) via env_file: [../.env, .env].
# NUNCA pongas aquí SERVER_IP ni TZ. Permisos 600.

# --- Autenticación (OBLIGATORIO) ---
# Genera con: openssl rand -base64 36
NEXTAUTH_SECRET=__pega_aqui__

# --- Meilisearch (OBLIGATORIO) ---
# Mismo valor lo consumen la app y el contenedor meilisearch.
# Genera con: openssl rand -base64 36 | tr -dc 'A-Za-z0-9'
MEILI_MASTER_KEY=__pega_aqui__

# --- IA: Ollama Cloud (endpoint OpenAI-compatible) ---
# API key desde https://ollama.com (Settings → API keys).
OPENAI_API_KEY=__pega_aqui__
OPENAI_BASE_URL=https://ollama.com/v1
# Modelo de tagging/resumen. Cloud disponibles: gpt-oss:20b (recomendado, barato),
# gpt-oss:120b (más capaz, gasta más cupo), qwen3-coder:480b, deepseek-v3.x ...
# Cambiar modelo = editar esta línea + 'svc restart karakeep'. NO se elige en la UI.
INFERENCE_TEXT_MODEL=gpt-oss:20b

# --- Búsqueda semántica (embeddings) — OPCIONAL, DEJADO DESACTIVADO ---
# Ollama Cloud (a fecha de este despliegue) sirve modelos de chat, NO de embeddings.
# Para activar semántica necesitas un proveedor de embeddings. Dos opciones:
#   (A) Embeddings locales con un Ollama local ligero (embeddinggemma):
#         EMBEDDING_OPENAI_BASE_URL=http://<tu-ollama-local>:11434/v1
#         EMBEDDING_OPENAI_API_KEY=ollama
#         EMBEDDING_TEXT_MODEL=embeddinggemma
#         EMBEDDING_DIMENSIONS=768
#         EMBEDDING_CONTEXT_LENGTH=2048
#         EMBEDDING_ENABLE_AUTO_INDEXING=true
#   (B) Otro proveedor OpenAI-compatible solo para embeddings.
# Sin esto, tienes tagging+resumen por IA y búsqueda FULL-TEXT (Meilisearch),
# pero NO búsqueda semántica. Ver docs/services/karakeep-guide.md.
