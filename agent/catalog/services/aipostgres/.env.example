# aipostgres — stack sucesor de DataSQL
# SERVER_IP y TZ se heredan de $dkco/.env mediante env_file.
# No copiar secretos reales al repositorio.

# === PostgreSQL 17 + pgvector + pg_search ===
POSTGRES_DB=aipostgres
POSTGRES_USER=aiadmin
POSTGRES_PASSWORD=__pega_aqui__

# === pgAdmin ===
PGADMIN_EMAIL=admin@local.lan
PGADMIN_PASSWORD=__pega_aqui__

# === Redis (nuevo airedis) ===
# Generar una contraseña nueva; no copiar REDIS_PASSWORD desde DataSQL.
REDIS_PASSWORD=__pega_aqui__

# Puertos temporales de coexistencia con DataSQL.
# PostgreSQL queda solo en loopback; Redis no publica puerto.
AIPG_POSTGRES_HOST_PORT=5433
AIPGADMIN_PORT=5051
