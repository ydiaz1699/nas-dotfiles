# VS Code Server — variables locales de Compose
# SERVER_IP y TZ se heredan desde $dkco/.env mediante env_file.
# Sustituir los placeholders solo en $dkco/vscode/.env; no guardar secretos reales en Git.
# NAS_DOTFILES debe ser el checkout real del repositorio en el NAS.
NAS_DOTFILES=__valor_de_NAS_DOTFILES__
VSCODE_UID=__uid_de_aadm__
VSCODE_GID=__gid_de_aadm__

# La contraseña NO va aquí: code-server la lee de
# config/code-server/config.yaml, que permanece local y con modo 600.
