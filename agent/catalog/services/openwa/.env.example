# OpenWA — variables locales del servicio.
# SERVER_IP y TZ se heredan desde $dkco/.env mediante env_file.
# Sustituir los placeholders SOLO en $dkco/openwa/.env; no guardar secretos en Git.

# Clave maestra de la API (obligatoria). Genera un valor fuerte en el NAS:
#   openssl rand -hex 32
# Se envía en cada request como cabecera:  X-API-Key: <valor>
API_MASTER_KEY=__pega_aqui__

# Pepper para el hashing HMAC de las API keys (recomendado). Genera otro valor:
#   openssl rand -hex 32
# OJO: al ponerlo o cambiarlo, las API keys ya emitidas dejan de validar y hay
# que re-emitirlas desde el dashboard.
API_KEY_PEPPER=__pega_aqui__

# Motor de WhatsApp. Por defecto whatsapp-web.js (estable, ~300-500MB RAM/sesión).
# Alternativa: baileys (más ligero; mejor soporte de eventos de llamadas).
ENGINE_TYPE=whatsapp-web.js
