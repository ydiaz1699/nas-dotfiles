# LobeHub 2.2.14 — secretos locales.
# SERVER_IP y TZ se heredan desde $dkco/.env; no duplicarlos aquí.
# LOBE_DB_PASSWORD debe coincidir con la contraseña de lobehub_user.
LOBE_DB_PASSWORD=__pega_aqui__
# Redis compartido: copiar localmente el valor de $dkco/datasql/.env.
REDIS_PASSWORD=__pega_aqui__
# Restringir el registro: lista no vacía y separada por comas.
AUTH_ALLOWED_EMAILS=__pega_aqui__
# KEY_VAULTS_SECRET debe ser Base64 y decodificar a 16, 24 o 32 bytes.
# Generar, por ejemplo, con: openssl rand -base64 32
KEY_VAULTS_SECRET=__pega_aqui__
AUTH_SECRET=__pega_aqui__
JWKS_KEY=__pega_aqui__
# Credencial del RustFS privado para el servicio LobeHub.
RUSTFS_SECRET_KEY=__pega_aqui__
