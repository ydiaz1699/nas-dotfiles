# Rutas operativas del framework; no poner secretos aquí.
NAS_DOTFILES=/nas-dotfiles
DOCKER_BASE=/docker
# Token independiente del token histórico de LobeHub.
NAS_MCP_SERVICE_TOKEN=__pega_aqui__
# GID real del grupo privado nas-mcp.
MCP_SOCKET_GID=__configura_gid_del_grupo_nas_mcp__
# Socket creado por systemd; no crear manualmente.
MCP_HELPER_SOCKET=/run/nas/nas-mcp-gateway.sock
# Vacío: solo clientes server-to-server sin Origin.
MCP_ALLOWED_ORIGINS=
# El worker lazy se detiene tras este tiempo sin tools/call.
NAS_MCP_IDLE_SECONDS=600
