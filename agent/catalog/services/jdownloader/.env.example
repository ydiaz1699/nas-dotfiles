# $dkco/jdownloader/.env  — secretos/ajustes locales del servicio (chmod 600)
# SERVER_IP y TZ NO van aquí: se heredan de $dkco/.env global.
#
# Instalar:
#   cp .env.example .env
#   nano .env
#   chmod 600 .env

# UID/GID con los que corre el contenedor (deben poder escribir en ./config y ./output).
# Ver en el NAS con: id -u  /  id -g   (aadm suele ser 1000)
JD_USER_ID=1000
JD_GROUP_ID=1000

# --- Auth de la GUI web (solo si expones el :5800 en tu LAN) ---
# Descomenta también las líneas WEB_AUTHENTICATION_* en compose.yml
# JD_WEB_USER=__pega_aqui__
# JD_WEB_PASSWORD=__pega_aqui__
