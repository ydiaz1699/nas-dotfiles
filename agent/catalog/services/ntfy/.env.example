# ntfy — Variables de entorno
# Copiar a .env y ajustar valores
#
# Nota: SERVER_IP y TZ se heredan de $dkco/.env (env_file: ../.env)
# Este archivo solo necesita variables específicas de ntfy (si las hay)

# Override timezone si difiere del global
# TZ=America/La_Paz

# Override server IP si difiere del global
# SERVER_IP=192.168.1.200
