# EMQX — Variables de entorno
# Copiar a $dkco/emqx/.env y reemplazar __pega_aqui__
# chmod 600 $dkco/emqx/.env

# Secretos (generar con: openssl rand -hex 32)
EMQX_NODE_COOKIE=__pega_aqui__
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=__pega_aqui__

# Seguridad
EMQX_ALLOW_ANONYMOUS=false

# Puertos (cambiar solo si hay conflicto)
EMQX_PORT_MQTT=1883
EMQX_PORT_MQTTS=8883
EMQX_PORT_WS=8083
EMQX_PORT_WSS=8084
EMQX_PORT_DASHBOARD=18083
