{
  "schema_version": "1.0",
  "name": "nas-framework-architecture",
  "description": "Contratos verificables entre runtime, interfaces, conocimiento y documentación del framework nas-dotfiles + DebMenux.",
  "repositories": {
    "nas_dotfiles": ".",
    "debmenux": "../DebMenux-"
  },
  "dependency_levels": {
    "functional": {
      "severity": "error",
      "description": "La conexión es necesaria para que la capacidad pueda ejecutarse."
    },
    "interface": {
      "severity": "warning",
      "description": "La capacidad funciona, pero falta una interfaz o experiencia de uso."
    },
    "knowledge": {
      "severity": "warning",
      "description": "El agente o la skill no conocen la capacidad o sus reglas."
    },
    "documentation": {
      "severity": "info",
      "description": "La capacidad funciona, pero una referencia pública está desactualizada o ausente."
    },
    "historical": {
      "severity": "info",
      "description": "Falta contexto de decisiones o continuidad; no afecta la ejecución inmediata."
    }
  },
  "entities": {
    "svc_command": {
      "description": "Comando público expuesto como svc <comando>.",
      "discovery": {
        "bash": "docker/cli/svc.sh",
        "python": "svc_py/app.py",
        "completion": "shell/lib/docker.sh"
      },
      "knowledge_surfaces": [
        "agent/nas_agent.py",
        "docker-nas/references/nas-context.md"
      ],
      "documentation_surfaces": [
        "AGENTS.md",
        "GUIDE.md",
        "docker-nas/references/svc.md",
        "docs/dependency-map.md"
      ]
    },
    "service": {
      "description": "Servicio Docker o servicio nativo integrado al ecosistema.",
      "discovery": {
        "compose": "docker/*/compose.yml",
        "catalog": "agent/catalog/services/*",
        "guide": "docs/services/*-guide.md",
        "debmenux_script": "../DebMenux-/scripts/services/*.sh",
        "debmenux_registry": "../DebMenux-/services.json"
      }
    },
    "agent_tool": {
      "description": "Tool Python invocable por el agente.",
      "discovery": {
        "implementation": "agent/tools/*.py",
        "registration": "agent/tools/__init__.py",
        "prompt": "agent/nas_agent.py"
      }
    },
    "mcp_gateway": {
      "description": "Gateway MCP histórico read-only integrado con LobeHub; se mantiene por compatibilidad.",
      "discovery": {
        "implementation": "agent/lobehub_mcp.py",
        "sidecar_dockerfile": "agent/mcp/Dockerfile",
        "helper_systemd": "systemd/lobehub-mcp-helper.service",
        "documentation": "docs/lobehub-mcp-gateway.md"
      }
    },
    "nas_mcp_gateway": {
      "description": "Gateway MCP independiente read-only con front-door lazy y helper host allowlisted.",
      "discovery": {
        "implementation": "agent/mcp/nas_mcp_gateway/nas_mcp_gateway.py",
        "worker": "agent/mcp/nas_mcp_gateway/nas_mcp_worker.py",
        "manifest": "agent/mcp/nas_mcp_gateway/nas_mcp_manifest.json",
        "sidecar_dockerfile": "agent/mcp/nas_mcp_gateway/Dockerfile",
        "helper_systemd": "systemd/nas-mcp-helper.service",
        "catalog": "agent/catalog/services/nas-mcp-gateway/compose.yml",
        "documentation": "docs/nas-mcp-gateway.md",
        "skill": ".kiro/skills/nas-mcp-gateway/SKILL.md"
      }
    },
    "draft": {
      "description": "Entrada temporal que debe clasificarse antes de convertirse en código o documentación.",
      "discovery": {
        "directory": "_drafts/",
        "rules": "docs/dependency-map.md"
      }
    }
  },
  "cli_contract": {
    "parity_mode": "report",
    "required_shared_commands": [
      "lista",
      "health",
      "doctor",
      "update-all",
      "port-map",
      "size",
      "net",
      "watch",
      "create",
      "diff",
      "catalog-sync",
      "capabilities",
      "lobehub",
      "scan",
      "menu",
      "backup",
      "restore",
      "snapshot",
      "depends",
      "open",
      "env",
      "up",
      "down",
      "start",
      "stop",
      "restart",
      "kill",
      "update",
      "logs"
    ],
    "allowed_bash_only_commands": [
      "backup-all",
      "logs-grep",
      "clone",
      "cron",
      "doctor-history",
      "lock",
      "unlock",
      "rollback"
    ],
    "allowed_python_only_commands": [],
    "contract_surfaces": {
      "functional": [
        "docker/cli/svc.sh",
        "svc_py/app.py"
      ],
      "interface": [
        "shell/lib/docker.sh"
      ],
      "knowledge": [
        "agent/nas_agent.py",
        "docker-nas/references/nas-context.md"
      ],
      "documentation": [
        "AGENTS.md",
        "GUIDE.md",
        "docker-nas/references/svc.md",
        "docs/dependency-map.md"
      ]
    }
  },
  "connection_contracts": [
    {
      "id": "catalog-sync-entrypoints",
      "entity": "svc_command",
      "name": "catalog-sync",
      "level": "functional",
      "required": [
        "docker/cli/svc.sh",
        "docker/cli/lib/catalog-sync.sh",
        "svc_py/app.py",
        "svc_py/commands/catalog.py"
      ]
    },
    {
      "id": "scan-entrypoints",
      "entity": "svc_command",
      "name": "scan",
      "level": "functional",
      "required": [
        "docker/cli/svc.sh",
        "agent/tools/project_scanner.py",
        "svc_py/app.py",
        "svc_py/commands/scanner.py"
      ]
    },
    {
      "id": "catalog-sync-knowledge",
      "entity": "svc_command",
      "name": "catalog-sync",
      "level": "knowledge",
      "required": [
        "agent/nas_agent.py",
        "docker-nas/references/nas-context.md"
      ]
    },
    {
      "id": "scan-knowledge",
      "entity": "svc_command",
      "name": "scan",
      "level": "knowledge",
      "required": [
        "agent/nas_agent.py",
        "docker-nas/references/nas-context.md"
      ]
    },
    {
      "id": "lobehub-mcp-gateway",
      "entity": "mcp_gateway",
      "name": "LobeHub read-only MCP",
      "level": "functional",
      "required": [
        "agent/lobehub_mcp.py",
        "agent/.dockerignore",
        "agent/mcp/Dockerfile",
        "systemd/lobehub-mcp-helper.service",
        "agent/catalog/services/lobehub/compose.yml",
        "docs/lobehub-mcp-gateway.md"
      ]
    },
    {
      "id": "nas-mcp-gateway-lazy-frontdoor",
      "entity": "nas_mcp_gateway",
      "name": "nas-mcp-gateway lazy read-only MCP",
      "level": "functional",
      "required": [
        "agent/mcp/nas_mcp_gateway/nas_mcp_gateway.py",
        "agent/mcp/nas_mcp_gateway/nas_mcp_worker.py",
        "agent/mcp/nas_mcp_gateway/nas_mcp_manifest.json",
        "agent/.dockerignore",
        "agent/mcp/nas_mcp_gateway/Dockerfile",
        "systemd/nas-mcp-helper.service",
        "agent/catalog/services/nas-mcp-gateway/compose.yml",
        "docs/nas-mcp-gateway.md",
        ".kiro/skills/nas-mcp-gateway/SKILL.md"
      ]
    }
  ],
  "generated_artifacts": {
    "project_index": "agent/cache/project-index.json",
    "note": "El índice se genera desde este contrato y el código actual; no reemplaza el snapshot incremental de project-snapshot.json."
  }
}
