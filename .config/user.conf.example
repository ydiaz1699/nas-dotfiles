# .config/user.conf — Configuración personalizada del usuario
# Generado automáticamente por install.sh en la primera instalación
# Copiar a user.conf y editar manualmente si se necesita cambiar después
#
# NAV_HOME: Ruta del directorio home del usuario (para navegación rápida)
# NAV_VAR:  Nombre de la variable exportada (ej: $aadm, $nilo, $juan)
# NAV_CMD:  Nombre del comando de navegación (ej: adm, nil, jua)

NAV_HOME="/home/tu_usuario"
NAV_VAR="usuario"
NAV_CMD="usr"
