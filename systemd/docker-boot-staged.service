# /etc/systemd/system/docker-boot-staged.service
# Arranque escalonado de los Compose definidos en $dkco/scripts/layers.conf.
# Instalar después de copiar layers.conf al NAS y validar manualmente el script.

[Unit]
Description=Arranque escalonado de contenedores Docker del NAS
Documentation=https://github.com/ydiaz1699/nas-dotfiles/blob/main/docs/docker-boot-staged-guide.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/docker
ConditionPathExists=/nas-dotfiles/shell/scripts/boot-order.sh
ConditionPathExists=/docker/scripts/layers.conf

[Service]
Type=oneshot
User=root
WorkingDirectory=/nas-dotfiles
Environment=NAS_DOTFILES=/nas-dotfiles
Environment=DOCKER_BASE=/docker
Environment=BOOT_ORDER_CONFIG=/docker/scripts/layers.conf
Environment=BOOT_ORDER_LOG=/docker/scripts/boot-order.log
Environment=BOOT_ORDER_REQUIRE_ALL=1
Environment=BOOT_ORDER_HEALTH_TIMEOUT=120
# Arranque secuencial dentro de cada capa (uno a uno). Es el comportamiento por
# defecto (menor pico de I/O). Para arrancar cada capa en paralelo, poner 0:
Environment=BOOT_ORDER_SERIAL=1
ExecStart=/nas-dotfiles/shell/scripts/boot-order.sh
RemainAfterExit=yes
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
