# Copiar a /etc/nas/lobehub-mcp-helper.env y ajustar solo si las rutas
# del checkout o de Docker difieren de las convenciones del NAS.
NAS_DOTFILES=/nas-dotfiles
DOCKER_BASE=/docker
MCP_HELPER_SOCKET=/run/nas/lobehub-mcp.sock
MCP_SOCKET_GID=__configura_gid_del_grupo_nas_mcp__
MCP_AUDIT_LOG=/var/lib/nas/lobehub-mcp/audit.jsonl
