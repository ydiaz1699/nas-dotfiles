# Configuración de arranque escalonado para $dkco/scripts/layers.conf
#
# Cada bloque separado por una línea en blanco es una capa. Por defecto, los
# servicios de una misma capa arrancan uno a uno (secuencial), esperando que
# cada uno esté running/healthy antes del siguiente; la siguiente capa no
# empieza hasta terminar la actual. Con BOOT_ORDER_SERIAL=0 la capa arranca
# en paralelo.
#
# Esta plantilla refleja los servicios catalogados. Antes de habilitar systemd,
# compara `svc lista` con este archivo: agrega servicios reales y elimina los
# que no estén instalados. No agregues flowise-worker: es un servicio interno
# del Compose de flowise, no un proyecto que `svc` pueda arrancar por separado.
#
# Para dejar un servicio fuera del boot sin borrarlo de aquí, usa:
#   svc no-boot <svc>      (boot-order.sh lo salta con aviso, no bloquea)
#   svc boot-enable <svc>  (lo reactiva)
# Un servicio con .no-boot se salta y el arranque continúa con el siguiente.

# Capa 1 — PostgreSQL y Redis compartidos
datasql

# Capa 2 — Consumidores de DataSQL (Compose independiente)
# Home Assistant primero: usa PostgreSQL (Recorder) y debe conectar apenas
# datasql esté healthy.
homeassistant
n8n
flowise
lobehub

# Capa 3 — Broker IoT y servicios independientes con acceso host
emqx
esphome

# Capa 4 — Consumidores MQTT
iobroker
node-red

# Capa 5 — Servicios de archivos y notificaciones
filebrowser
ntfy

# Capa 6 — Dashboard y servicios auxiliares; Homepage queda al final
vscode
nas-mcp-gateway
homepage

# Opcionales no presentes en todos los NAS: descomentar solo si existen.
# adguard
# spacedrive
# tasmoadmin
